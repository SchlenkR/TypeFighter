<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
        <OutputType>Exe</OutputType>
        <AssemblyName>TypeFighter.Wasm</AssemblyName>
        <RootNamespace>PureState.TypeFighter.Wasm</RootNamespace>
        <WasmMainJSPath>wwwroot/main.js</WasmMainJSPath>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <!-- Assembly.TryGetRawMetadata in ReferencePool -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <!-- Roslyn + Reflection over freshly compiled assemblies: no trimming -->
        <PublishTrimmed>false</PublishTrimmed>
        <CompressionEnabled>true</CompressionEnabled>
        <!-- TypeFighter only ever uses InvariantCulture; skipping ICU saves ~1 MB -->
        <InvariantGlobalization>true</InvariantGlobalization>
    </PropertyGroup>

    <ItemGroup>
        <SupportedPlatform Include="browser" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\TypeFighter.Web\TypeFighter.Web.fsproj" />
    </ItemGroup>

</Project>
