        <AssemblyName>PureState.TypeFighter.Web</AssemblyName>
        <RootNamespace>PureState.TypeFighter.Web</RootNamespace>
        <LangVersion>preview</LangVersion>
    </PropertyGroup>

    <ItemGroup>
